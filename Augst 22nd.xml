            self._blit(f"{mn:.1f}", rect.x + 4, gy + ph - 8, self.f_tiny, DIM)

        pts = []
        for i, v in enumerate(values):
            nx = i / (len(values) - 1)
            ny = (v - mn) / (mx - mn)
            pts.append((int(gx + nx * pw), int(gy + ph - ny * ph)))
        if len(pts) >= 2:
            pygame.draw.lines(self.screen, color, False, pts, 1)
