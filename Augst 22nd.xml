        gy = rect.y + pad_top

        mn, mx = min(values), max(values)
        if mn == mx: mx = mn + 1.0

        if draw_axes:
            pygame.draw.line(self.screen, DIM2, (gx, gy), (gx, gy + ph))
            pygame.draw.line(self.screen, DIM2, (gx, gy + ph), (gx + pw, gy + ph))
