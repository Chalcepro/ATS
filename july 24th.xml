<file path="world.py">
"""Tile world, starting room, chunk generation, and item/drop placement.

Interactivity guarantee: every tile the agent can reach either
  (a) has an item object they can PICK_UP,
  (b) has an entity they can ATTACK or INTERACT with, or
  (c) is open floor they can MOVE through.
No dead zones — empty corridors still let the agent move.
"""

from __future__ import annotations

import random
from dataclasses import dataclass, field

import biome as biome_mod
import config_rl
from entities import Entity

# Chunk configuration – each chunk is a square of tiles generated lazily.
CHUNK_SIZE = 16  # 16x16 tiles per chunk


TILE_EMPTY = 0
TILE_WALL = 1
TILE_HOSTILE = 2
TILE_OBJECT = 3
TILE_NPC = 4
TILE_WATER = 5
TILE_LAVA = 6


@dataclass
class Tile:
    tile_type: int = TILE_EMPTY
    z: int = 0
    object_id: str = ""
    explored: bool = False
    biome: int = 0
    flags: str = ""
    drop_item: str = ""  # item placed here by entity death / chest


class World:
    def __init__(self):
        self.tiles: dict[tuple[int, int], Tile] = {}
        self.entities: list[Entity] = []
        self.door_unlocked = False
        self.agent_spawn = (0, 0)
        # Starting room will be generated lazily when accessed.
        # No immediate tile creation here.
        # Ensure the start chunk exists so that the spawn area is ready.
        self._ensure_chunk_generated(*self.agent_spawn)
        self._build_starting_room()


    # ------------------------------------------------------------------
    # Tile access
    # ------------------------------------------------------------------
    def _tile(self, x: int, y: int) -> Tile:
        """Return a Tile, generating it on demand if it does not exist.

        Tiles are generated per‑chunk. When a coordinate falls outside the current
        cache, the corresponding chunk is created using the biome and elevation
        helpers from ``biome_mod``.
        """
        # Ensure the chunk containing (x, y) exists.
        self._ensure_chunk_generated(x, y)
        key = (x, y)
        if key not in self.tiles:
            # Fallback – should not happen because _ensure_chunk_created fills it.
            self.tiles[key] = Tile(
                tile_type=TILE_EMPTY,
                z=0,
                biome=biome_mod.biome_at(x, y),
            )
        return self.tiles[key]

    def _ensure_chunk_generated(self, x: int, y: int) -> None:
        """Generate all tiles for the chunk containing ``(x, y)``.

        The world is divided into ``CHUNK_SIZE`` squares. For each coordinate we
        calculate the chunk origin and fill the tile dictionary for that region.
        """
        chunk_x = (x // CHUNK_SIZE) * CHUNK_SIZE
        chunk_y = (y // CHUNK_SIZE) * CHUNK_SIZE
        for dy in range(CHUNK_SIZE):
            for dx in range(CHUNK_SIZE):
                tx = chunk_x + dx
                ty = chunk_y + dy
                if (tx, ty) not in self.tiles:
                    self.tiles[(tx, ty)] = Tile(
                        tile_type=TILE_EMPTY,
                        z=biome_mod.get_elevation(tx, ty),
                        biome=biome_mod.biome_at(tx, ty),
                    )


    # ------------------------------------------------------------------
    # Starting room builder
    # ------------------------------------------------------------------
    def _build_starting_room(self):
        """Create the initial 5×5 room (as defined in the GDD).

        The method relies on the lazy chunk system – calling ``_tile`` will
        automatically generate the necessary chunk tiles with proper biome and
        elevation values before we modify them.
        """
        size = config_rl.STARTING_ROOM_SIZE
        half = size // 2

        for y in range(-half, half + 1):
            for x in range(-half, half + 1):
                tile = self._tile(x, y)
                # The starting room is always at sea level (z = 0) and in the
                # Forest biome (index 0) regardless of the procedural generation.
                tile.z = 0
                tile.biome = 0
                tile.tile_type = TILE_WALL if (abs(x) == half or abs(y) == half) else TILE_EMPTY

        # Door tile (locked until sword + slime condition)
        door_tile = self._tile(0, half)
        door_tile.tile_type = TILE_WALL
        door_tile.flags = "door"

        # Starter items – placed directly on the floor tiles.
        self._place_object(1, 0, "0001")    # Apple
        self._place_object(-1, 0, "0002")   # Sword Basic
        self._place_object(0, -1, "0003")   # Book
        self._place_object(2, 1, "0009")    # Coal
        self._place_object(-2, -1, "0010")  # Wood
        self._place_object(2, -2, "0010")   # Wood

        # Starter entity: one Weak Slime positioned just outside the door.
        self.entities.append(Entity.from_id("E001", 0, 1))
        self.agent_spawn = (0, 0)

    def _place_object(self, x: int, y: int, item_id: str):
        tile = self._tile(x, y)
        tile.object_id = item_id
        tile.tile_type = TILE_OBJECT

    # ------------------------------------------------------------------
    # Drop spawn: place a loot item on the map when entity dies
    # ------------------------------------------------------------------
    def spawn_drop(self, x: int, y: int, item_id: str):
        """Place *item_id* at (x,y). If occupied, scatter to adjacent tile."""
        if not item_id:
            return
        candidates = [(x, y)] + [(x + dx, y + dy) for dx, dy in [(0,1),(1,0),(0,-1),(-1,0)]]
        for cx, cy in candidates:
            tile = self._tile(cx, cy)
            if tile.tile_type not in (TILE_WALL,) and not tile.object_id:
                tile.object_id = item_id
                tile.tile_type = TILE_OBJECT
                return
        # Fallback: force-place on death tile
        tile = self._tile(x, y)
        tile.object_id = item_id
        tile.tile_type = TILE_OBJECT

    # ------------------------------------------------------------------
    # Door / progression
    # ------------------------------------------------------------------
    def unlock_door_if_ready(self, has_sword: bool, slime_dead: bool):
        if has_sword and slime_dead and not self.door_unlocked:
            self.door_unlocked = True

    # ------------------------------------------------------------------
    # Passability
    # ------------------------------------------------------------------
    def in_bounds_passable(self, x: int, y: int, door_unlocked: bool) -> bool:
        tile = self._tile(x, y)
        if tile.tile_type == TILE_WALL:
            return False
        if tile.tile_type == TILE_LAVA:
            return False
        # Block movement through alive hostile entities
        for ent in self.entities:
            if ent.alive and ent.x == x and ent.y == y:
                ent_type = ent.data.get("type", "hostile")
                if ent_type == "hostile":
                    return False
        return True

    # ------------------------------------------------------------------
    # Height map helpers
    # ------------------------------------------------------------------
    def get_adjacent_z(self, x: int, y: int) -> dict:
        return {
            "ahead":  self._tile(x, y - 1).z,
            "behind": self._tile(x, y + 1).z,
            "left":   self._tile(x - 1, y).z,
            "right":  self._tile(x + 1, y).z,
        }

    # ------------------------------------------------------------------
    # Exploration fog
    # ------------------------------------------------------------------
    def mark_explored(self, x: int, y: int, radius: int):
        for dy in range(-radius, radius + 1):
            for dx in range(-radius, radius + 1):
                if abs(dx) + abs(dy) <= radius:
                    self._tile(x + dx, y + dy).explored = True

    # ------------------------------------------------------------------
    # Entity queries
    # ------------------------------------------------------------------
    def nearest_entity(self, x: int, y: int):
        best, best_dist = None, 999
        for ent in self.entities:
            if not ent.alive:
                continue
            d = abs(ent.x - x) + abs(ent.y - y)
            if d < best_dist:
                best, best_dist = ent, d
        return best, best_dist

    def nearest_entity_chebyshev(self, x: int, y: int):
        """Like nearest_entity but returns Chebyshev (max-of-abs) distance."""
        best, best_dist = None, 999
        for ent in self.entities:
            if not ent.alive:
                continue
            d = max(abs(ent.x - x), abs(ent.y - y))
            if d < best_dist:
                best, best_dist = ent, d
        return best, best_dist

    def entity_at(self, x: int, y: int) -> Entity | None:
        for ent in self.entities:
            if ent.alive and ent.x == x and ent.y == y:
                return ent
        return None

    # ------------------------------------------------------------------
    # Object queries
    # ------------------------------------------------------------------
    def nearest_object(self, x: int, y: int):
        best_id, best_dist = "", 999
        for (tx, ty), tile in self.tiles.items():
            if tile.object_id:
                d = abs(tx - x) + abs(ty - y)
                if d < best_dist:
                    best_id, best_dist = tile.object_id, d
        return best_id, best_dist

    # ------------------------------------------------------------------
    # Tile type at position (entity presence overrides tile)
    # ------------------------------------------------------------------
    def tile_type_at(self, x: int, y: int) -> int:
        # Entities are prioritized over tile type for interaction logic.
        if any(e.alive and e.x == x and e.y == y for e in self.entities):
            return TILE_HOSTILE
        tile = self._tile(x, y)
        if tile.object_id:
            return TILE_OBJECT
        return tile.tile_type

    # ------------------------------------------------------------------
    # Pick up item at position
    # ------------------------------------------------------------------
    def pickup_at(self, x: int, y: int) -> str:
        tile = self._tile(x, y)
        item = tile.object_id
        tile.object_id = ""
        if tile.tile_type == TILE_OBJECT:
            tile.tile_type = TILE_EMPTY
        return item

    # ------------------------------------------------------------------
    # Attack — returns (killed_entity_id, drop_item_id)
    # ------------------------------------------------------------------
    def attack_at(self, x: int, y: int, damage: int, attacker_pos: tuple[int, int] | None = None) -> tuple[str, str]:
        """Attack entity within 3×3 square (Chebyshev dist ≤ 1) of (x,y).

        Returns (killed_entity_id, drop_item_id).
        drop_item_id is non-empty only when the entity dies this tick.
        """
        for ent in self.entities:
            if ent.alive and max(abs(ent.x - x), abs(ent.y - y)) <= 1:
                ent.take_damage(damage, attacker_pos=attacker_pos)
                if not ent.alive:
                    drop = ent.drop_item_id()
                    return ent.entity_id, drop
                return "", ""
        return "", ""

    # ------------------------------------------------------------------
    # Spawn a new entity (for Phase B+ chunk generation)
    # ------------------------------------------------------------------
    def spawn_entity(self, entity_id: str, x: int, y: int):
        self.entities.append(Entity.from_id(entity_id, x, y))
