<file path="biome.py">
"""Biome definitions and blend helpers."""

BIOMES = {
    0: "Forest",
    1: "Desert",
    2: "Volcanic",
    3: "Plains",
    4: "Cave",
    5: "Tundra",
    6: "Swamp",
}


def biome_at(x, y, seed=12345):
    """Return a biome index based on pseudo‑noise.

    A simple deterministic hash is used to avoid external dependencies. The
    hash is mixed with the provided ``seed`` to produce repeatable values across
    runs. The resulting integer is mapped into the defined biomes with a
    blending zone of up to 15 tiles.
    """
    # Create a reproducible integer from coordinates and seed
    h = (x * 374761393 + y * 668265263 + seed * 0x9E3779B9) & 0xFFFFFFFFFFFFFFFF
    # Mix bits (xorshift)
    h ^= (h >> 13)
    h ^= (h << 7) & 0xFFFFFFFFFFFFFFFF
    h ^= (h >> 17)
    # Normalise to [0, 1)
    value = (h % 10000) / 10000.0
    # Determine base biome zones (roughly matching original simple layout)
    if abs(x) + abs(y) < 20:
        base = 0  # Forest core
    elif x > 30:
        base = 1  # Desert
    elif y > 30:
        base = 2  # Volcanic
    elif x < -30:
        base = 5  # Tundra
    elif y < -30:
        base = 6  # Swamp
    else:
        base = 3  # Plains
    # Apply a simple blending: if value is near the border, shift to neighbouring biome
    # Blend zones are 15 tiles wide; we approximate by nudging the biome based on value
    if value < 0.1:
        # Slight chance to move to the previous biome in the enumeration (wrap)
        base = (base - 1) % len(BIOMES)
    elif value > 0.9:
        base = (base + 1) % len(BIOMES)
    return base

def get_elevation(x, y, seed=98765):
    """Return a deterministic elevation (Z) for a tile.

    The elevation is generated from a simple hash based on coordinates and a
    separate seed. The value is scaled to the range -1000 .. +1000 as described
    in the GDD.
    """
    h = (x * 6364136223846793005 + y * 1442695040888963407 + seed) & 0xFFFFFFFFFFFFFFFF
    # Mix bits
    h ^= (h >> 21)
    h ^= (h << 37) & 0xFFFFFFFFFFFFFFFF
    h ^= (h >> 4)
    # Normalise to [-1, 1]
    val = ((h % 2000) - 1000) / 1000.0
    # Scale to the desired Z range
    return int(val * 1000)



def blend_weight(distance_to_border):
    distance = max(0, min(15, distance_to_border))
    return distance / 15.0
