# -*- coding: utf-8 -*-
"""ATS main entrypoint — sim runner and training mode selector.

Wires the simulation loop to the Mind architecture:
  SolutionLoop  — perceive → need → recall → act → record
  ContinualLearner — mini PPO update every N ticks
"""

import argparse
import time

import torch

import config_rl
from ats_env import ATSEnvironment
from ats_virus_adapter import VirusAdapter
from debug_gui import TerminalGUI
from mind.continual_learner import ContinualLearner
from mind.solution_loop import SolutionLoop
from model_rl import RLPolicy


def parse_args():
    parser = argparse.ArgumentParser(description="ATS simulation")
    parser.add_argument("--episodes", type=int, default=3, help="Number of episodes to run")
    parser.add_argument("--ticks", type=int, default=None, help="Max ticks per episode (default: 500 from config_rl)")
    parser.add_argument("--train", action="store_true", help="Run PPO training")
    parser.add_argument(
        "--no-gui",
        action="store_true",
        help="Headless (no window) — for training/CI only",
    )
    parser.add_argument("--virus-profile", default=config_rl.VIRUS_PROFILE)
    return parser.parse_args()


def run_sim(args):
    if args.ticks is not None:
        config_rl.MAX_TICKS = args.ticks

    gui = None
    if not args.no_gui:
        gui = TerminalGUI()
        gui.splash(duration=2.0)
        if not gui.alive:
            return

    env = ATSEnvironment()
    adapter = VirusAdapter(profile=args.virus_profile)
    adapter.write_active_profile()

    # Build policy — load from checkpoint if available
    policy = RLPolicy()
    if config_rl.MODEL_PATH.exists():
        ckpt = torch.load(config_rl.MODEL_PATH, map_location="cpu")
        # Support both raw state_dict and wrapped checkpoint
        state_dict = ckpt.get("model_state_dict", ckpt.get("model_stlte_dict", ckpt)) if isinstance(ckpt, dict) else ckpt
        policy.load_state_dict(state_dict)
        print(f"[ATS] Loaded policy from {config_rl.MODEL_PATH}")
    policy.eval()

    # Mind: SolutionLoop orchestrates the cognitive cycle
    # ContinualLearner shares the same policy and updates it every N ticks
    solution_loop = SolutionLoop(policy=policy)
    learner = ContinualLearner(policy=policy)

    for ep in range(args.episodes):
        state = env.reset()
        done = False
        ep_rewards = []

        while not done:
            if gui and not gui.alive:
                break

            # Action mask from current agent context
            mask = env.agent.get_action_mask(env.world, env.day_night)

            # Mind's cognitive cycle → produces action index
            action = solution_loop.choose_action(state, mask)

            disabled = gui.disabled_actions if gui else set()
            reward_rules = gui.reward_rules if gui else None
            state, reward, done, info = env.step(action, disabled_actions=disabled, reward_rules=reward_rules)
            ep_rewards.append(reward)

            # Feed experience to continual learner (updates in background every 256 ticks)
            learner.collect(
                state=state,
                action=action,
                reward=reward,
                log_prob=solution_loop.last_log_prob,
                value=solution_loop.last_value,
                action_mask=mask,
            )
            learner.maybe_update()

            if gui:
                # Pass needs to GUI for NEEDS panel
                if not gui.render(env, needs=info.get("needs", [0, 0, 0, 0]),
                                   trace=solution_loop.trace):
                    break
            else:
                time.sleep(0.01 / max(config_rl.SPEED_MULTIPLIER, 0.1))

        if gui and not gui.alive:
            break

        # Try updating at episode end
        learner.maybe_update()

        total_rew = sum(ep_rewards)
        narration = adapter.generate_narration(
            f"### INPUT: ATS episode {ep + 1} reward {total_rew:.2f}\n### OUTPUT:"
        )
        adapter.export_runtime_corpus(
            [
                f"episode {ep + 1} summary|Agent finished with reward {total_rew:.2f}",
                f"episode {ep + 1} narration|{narration}",
            ]
        )
        print(f"Episode {ep + 1} complete | total reward={total_rew:.2f} | ticks={env.tick}")

    # Save updated policy
    config_rl.CHECKPOINT_DIR.mkdir(parents=True, exist_ok=True)
    torch.save({"model_state_dict": policy.state_dict()}, config_rl.MODEL_PATH)
    print(f"[ATS] Saved policy -> {config_rl.MODEL_PATH}")

    if gui:
        gui.close()


def main():
    args = parse_args()
    if args.train:
        from train_rl import train
        train()
        return
    run_sim(args)


if __name__ == "__main__":
    main()
