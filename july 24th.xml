"""Pygame window that looks like a classic terminal (not the OS console)."""

import time
import pygame

import config_rl
from item_ids import entity_name, item_name
from agent import ACTION_NAMES
from rewards import default_reward_rules

# Terminal palette — CRT feel, no textures/gradients
BG = (12, 12, 12)
FG = (0, 220, 90)
DIM = (0, 120, 50)
AMBER = (230, 180, 40)
RED = (220, 80, 60)
CYAN = (80, 220, 220)
MAGENTA = (200, 50, 200)
FRAME = (40, 40, 40)
WHITE = (200, 200, 200)

COLS = 120
ROWS = 52
CHAR_W = 9
CHAR_H = 16
MARGIN_X = 14
MARGIN_Y = 10

# Action toggle categories — each entry: (label, list of action indices)
_ACTION_TOGGLES = [
    ("FWD",   config_rl.ACT_MOVE_FORWARD),
    ("BACK",  config_rl.ACT_MOVE_BACKWARD),
    ("LEFT",  config_rl.ACT_MOVE_LEFT),
    ("RIGHT", config_rl.ACT_MOVE_RIGHT),
    ("SPRNT", config_rl.ACT_SPRINT_ON),
    ("JUMP",  config_rl.ACT_JUMP),
    ("ATK",   config_rl.ACT_ATTACK),
    ("PICK",  config_rl.ACT_PICK_UP),
    ("INTR",  config_rl.ACT_INTERACT),
    ("USE",   config_rl.ACT_USE_ITEM),
    ("INV",   config_rl.ACT_OPEN_INVENTORY),
    ("CRAFT", config_rl.ACT_OPEN_CRAFTING),
    ("SLEEP", config_rl.ACT_SLEEP),
    ("WAIT",  config_rl.ACT_WAIT),
]

# Reward rule toggle labels — short names for display
_RULE_LABELS = [
    ("STILL",    "standing_still"),
    ("DMG",      "damage_penalty"),
    ("WAIT",     "wait_penalty"),
    ("HUNGER",   "hunger_penalty"),
    ("WALL",     "wall_hit"),
    ("DEATH",    "death_penalty"),
    ("PICKUP",   "pickup_reward"),
    ("KILL",     "kill_reward"),
    ("EXPLORE",  "explore_reward"),
]


class TerminalGUI:
    def __init__(self, title="ATS // DEBUG TERMINAL"):
        pygame.init()
        self.width = MARGIN_X * 2 + COLS * CHAR_W
        self.height = MARGIN_Y * 2 + ROWS * CHAR_H
        self.screen = pygame.display.set_mode((self.width, self.height))
        pygame.display.set_caption(title)
        self.clock = pygame.time.Clock()
        self.font = self._load_font(14)
        self.small = self._load_font(12)
        self.alive = True
        self.frame = 0
        self._boot_done = False
        self._cursor_on = True
        self.action_log = []
        self.disabled_actions = set()
        self.reward_rules = default_reward_rules()

        # Toggle selection cursor for action toggles (used with number keys)
        self._action_cursor = 0
        self._rule_cursor = 0
        # Mode: 'action' or 'rule' — which row the cursor is on
        self._toggle_mode = "action"

    def _load_font(self, size):
        for name in ("Consolas", "Cascadia Mono", "Courier New", "monospace"):
            path = pygame.font.match_font(name)
            if path:
                return pygame.font.Font(path, size)
        return pygame.font.SysFont("courier", size)

    def process_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.alive = False
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    self.alive = False
                elif event.key == pygame.K_TAB:
                    # Switch between action and rule toggle rows
                    self._toggle_mode = "rule" if self._toggle_mode == "action" else "action"
                elif event.key == pygame.K_LEFT:
                    if self._toggle_mode == "action":
                        self._action_cursor = max(0, self._action_cursor - 1)
                    else:
                        self._rule_cursor = max(0, self._rule_cursor - 1)
                elif event.key == pygame.K_RIGHT:
                    if self._toggle_mode == "action":
                        self._action_cursor = min(len(_ACTION_TOGGLES) - 1, self._action_cursor + 1)
                    else:
                        self._rule_cursor = min(len(_RULE_LABELS) - 1, self._rule_cursor + 1)
                elif event.key == pygame.K_RETURN or event.key == pygame.K_SPACE:
                    if self._toggle_mode == "action":
                        act_idx = _ACTION_TOGGLES[self._action_cursor][1]
                        self._toggle_action(act_idx)
                    else:
                        rule_key = _RULE_LABELS[self._rule_cursor][1]
                        self.reward_rules[rule_key] = not self.reward_rules[rule_key]
                # Number keys 1-9: quick toggle for first 9 action toggles
                elif pygame.K_1 <= event.key <= pygame.K_9:
                    idx = event.key - pygame.K_1  # 0-based
                    if self._toggle_mode == "action" and idx < len(_ACTION_TOGGLES):
                        act_idx = _ACTION_TOGGLES[idx][1]
                        self._toggle_action(act_idx)
                    elif self._toggle_mode == "rule" and idx < len(_RULE_LABELS):
                        rule_key = _RULE_LABELS[idx][1]
                        self.reward_rules[rule_key] = not self.reward_rules[rule_key]
                # Legacy letter keys for quick movement toggles
                elif event.key == pygame.K_w:
                    self._toggle_action(config_rl.ACT_MOVE_FORWARD)
                elif event.key == pygame.K_a:
                    self._toggle_action(config_rl.ACT_MOVE_LEFT)
                elif event.key == pygame.K_s:
                    self._toggle_action(config_rl.ACT_MOVE_BACKWARD)
                elif event.key == pygame.K_d:
                    self._toggle_action(config_rl.ACT_MOVE_RIGHT)
        return self.alive

    def _toggle_action(self, act_idx):
        if act_idx in self.disabled_actions:
            self.disabled_actions.remove(act_idx)
        else:
            self.disabled_actions.add(act_idx)

    def splash(self, duration=2.0):
        boot = [
            "ATS BOOTLOADER v0.3 (Growing Mind Edition)",
            "============================================",
            "",
            "> mount /components/registry ........ OK",
            "> load world.tilemap ................ OK",
            "> init reward_engine ................ OK",
            "> bind virus.profile=ats ............ OK",
            "> boot mind.solution_loop ........... OK",
            "> boot mind.need_detector ........... OK",
            "> open debug terminal window ........ OK",
            "",
            "SYSTEM READY. Press simulation start...",
        ]
        start = time.time()
        shown = 0
        while self.alive and time.time() - start < duration:
            if not self.process_events():
                break
            elapsed = time.time() - start
            shown = min(len(boot), int(elapsed / (duration / max(len(boot), 1))) + 1)
            self._draw_frame(boot[:shown], splash=True)
            self.clock.tick(30)
        self._boot_done = True

    def render(self, env, needs=None, trace=None):
        if not self.alive:
            return False
        if not self.process_events():
            return False

        self.frame += 1
        self._cursor_on = (self.frame // 15) % 2 == 0

        if env.agent.last_action_name != "none" and self.frame > 1:
            self.action_log.append((env.agent.last_action_name, time.time()))

        current_time = time.time()
        self.action_log = [(a, t) for (a, t) in self.action_log if current_time - t < 15.0]
        if len(self.action_log) > 12:
            self.action_log = self.action_log[-12:]

        lines = self._build_lines(env, needs or [0, 0, 0, 0], trace or {})
        self._draw_frame(lines, splash=False)
        self.clock.tick(30)
        return True

    def close(self):
        self.alive = False
        pygame.quit()

    def _build_lines(self, env, needs, trace):
        agent = env.agent
        world = env.world
        biome = world._tile(agent.x, agent.y).biome
        world_rows = self._world_rows(world, agent)

        # 24-slot inventory mapping (2 columns of 12)
        inv_lines = []
        for i in range(12):
            left_slot = agent.inventory[i]
            right_slot = agent.inventory[i + 12]

            l_str = f"{i:02d}:" + (f"{left_slot['id']}:{item_name(left_slot['id'])[:10]}x{left_slot['count']}" if left_slot['id'] else "empty")
            r_str = f"{i + 12:02d}:" + (f"{right_slot['id']}:{item_name(right_slot['id'])[:10]}x{right_slot['count']}" if right_slot['id'] else "empty")

            if i == agent.selected_slot: l_str = ">" + l_str[1:]
            if i + 12 == agent.selected_slot: r_str = ">" + r_str[1:]

            inv_lines.append(f" {l_str:<25}| {r_str:<25}")

        ent, _ = world.nearest_entity(agent.x, agent.y)
        ent_label = f"{ent.entity_id} {entity_name(ent.entity_id)} state={ent.state}" if ent else "none"

        cursor = "_" if self._cursor_on else " "

        # Mask info
        mask = agent.get_action_mask(world, env.day_night)
        valid_acts = [ACTION_NAMES.get(i, str(i)) for i, m in enumerate(mask) if m]
        valid_str = ", ".join(valid_acts)[:60] + "..." if len(", ".join(valid_acts)) > 60 else ", ".join(valid_acts)

        lines = [
            ("=", FG),
            (" ATS // DEBUG TERMINAL" + cursor, FG),
            ("=", FG),
            ("", FG),
            (" INVENTORY (24 SLOTS)                                | WORLD VIEW (7x7)", DIM),
        ]

        # World view has 7 rows, inventory has 12 rows
        # Show first 7 inv rows alongside world view, then remaining 5 alongside needs
        for i in range(7):
            lines.append((f"{inv_lines[i]}| {world_rows[i]}", FG))

        for i in range(7, 12):
            if i == 7:
                lines.append((f"{inv_lines[i]}|  NEEDS DETECTOR", DIM))
            elif i == 8:
                lines.append((f"{inv_lines[i]}|   Hunger: {needs[0]:.2f}", RED if needs[0] > 0.5 else FG))
            elif i == 9:
                lines.append((f"{inv_lines[i]}|   Injury: {needs[1]:.2f}", RED if needs[1] > 0.5 else FG))
            elif i == 10:
                lines.append((f"{inv_lines[i]}|   Threat: {needs[2]:.2f}", RED if needs[2] > 0.5 else FG))
            elif i == 11:
                lines.append((f"{inv_lines[i]}|   Tool:   {needs[3]:.2f}", RED if needs[3] > 0.5 else FG))

        lines.extend([
            ("-", DIM),
            (f" HP:{agent.health:3d}/100  Hunger:{agent.hunger:3d}  Stamina:{agent.stamina:3d}  Lv:{agent.level}  XP:{agent.xp}", FG),
            (f" STATUS: leg={agent.leg_injured}  TIME:{env.day_night.time_of_day:.2f}  BIOME:{biome}  TORCH:{int(agent.torch_active)}", AMBER if env.day_night.is_night else FG),
            ("-", DIM),
            (" MIND TRACE", DIM),
            (f"   Detect : {trace.get('detect', '')[:90]}", CYAN),
            (f"   Recall : {trace.get('recall', '')[:90]}", CYAN),
            (f"   Act    : {trace.get('act', '')[:90]}", CYAN),
            (f"   Record : {trace.get('record', '')[:90]}", CYAN),
            ("-", DIM),
        ])

        # ---- ACTION TOGGLES (horizontal row of checkboxes) ----
        action_toggle_str = ""
        for idx, (label, act_idx) in enumerate(_ACTION_TOGGLES):
            enabled = act_idx not in self.disabled_actions
            check = "X" if enabled else " "
            marker = ">" if (self._toggle_mode == "action" and idx == self._action_cursor) else " "
            action_toggle_str += f"{marker}[{check}]{label} "

        lines.append((" ACTION TOGGLES (ENTER=flip | \u2190\u2192=move | TAB=switch row | 1-9=quick)", DIM))
        lines.append((f" {action_toggle_str}", FG))

        # ---- REWARD RULE TOGGLES (horizontal row) ----
        rule_toggle_str = ""
        for idx, (label, rule_key) in enumerate(_RULE_LABELS):
            enabled = self.reward_rules.get(rule_key, True)
            check = "X" if enabled else " "
            marker = ">" if (self._toggle_mode == "rule" and idx == self._rule_cursor) else " "
            rule_toggle_str += f"{marker}[{check}]{label} "

        lines.append((" REWARD RULES", DIM))
        lines.append((f" {rule_toggle_str}", AMBER))

        lines.append(("-", DIM))

        # ---- RECENT ACTIONS (compact horizontal) ----
        recent_strs = []
        seen = set()
        for a, t in reversed(self.action_log):
            age = time.time() - t
            if age > 10.0:
                continue
            key = a
            if key not in seen:
                seen.add(key)
                recent_strs.append(a)
            if len(recent_strs) >= 8:
                break
        recent_strs.reverse()
        recent_display = " \u2192 ".join(recent_strs) if recent_strs else "-"

        lines.append((f" RECENT: {recent_display}", CYAN))

        lines.extend([
            ("-", DIM),
            (f" EP:{env.episode}  TICK:{env.tick}  REWARD:{env.rewards.tick_reward:+.2f}  TOTAL:{env.rewards.total:.2f}  VALID:{valid_str}", FG),
            (f" LAST: {agent.last_action_name}  |  ENTITY: {ent_label}", FG if not ent or ent.state == 0 else RED),
            ("=", FG),
            (" ESC=quit | W/A/S/D=movement toggles | TAB=switch row | ENTER/SPACE=toggle | 1-9=quick", DIM),
        ])
        return lines

    def _world_rows(self, world, agent):
        """Build 7x7 world view rows."""
        rows = []
        for dy in range(-3, 4):
            cells = []
            for dx in range(-3, 4):
                x, y = agent.x + dx, agent.y + dy
                word = ""
                if dx == 0 and dy == 0:
                    word = "[AI]"
                else:
                    tile = world._tile(x, y)
                    ent = next((e for e in world.entities if e.alive and e.x == x and e.y == y), None)
                    if not tile.explored:
                        word = "??"
                    elif ent:
                        word = entity_name(ent.entity_id)
                    elif tile.object_id:
                        word = item_name(tile.object_id)
                    elif tile.tile_type == 1:
                        word = "Wall"
                    elif tile.tile_type == 5:
                        word = "Water"
                    elif tile.tile_type == 6:
                        word = "Lava"
                    else:
                        word = "."

                # Truncate to 6 chars and left-justify to exactly 6 chars
                word = word[:6].ljust(6)
                cells.append(word)
            rows.append(" ".join(cells))
        return rows

    def _draw_frame(self, lines, splash=False):
        self.screen.fill(BG)
        # Outer bezel
        pygame.draw.rect(
            self.screen,
            FRAME,
            pygame.Rect(4, 4, self.width - 8, self.height - 8),
            width=1,
        )
        pygame.draw.rect(
            self.screen,
            DIM,
            pygame.Rect(8, 8, self.width - 16, self.height - 16),
            width=1,
        )

        y = MARGIN_Y + 8
        for entry in lines:
            if isinstance(entry, tuple):
                text, color = entry
            else:
                text, color = entry, FG
            if text in ("=", "-"):
                text = ("=" if text == "=" else "-") * (COLS - 4)
                color = DIM
            # Clamp to terminal width
            if len(text) > COLS - 2:
                text = text[: COLS - 2]
            surf = self.font.render(text, True, color)
            self.screen.blit(surf, (MARGIN_X, y))
            y += CHAR_H
            if y > self.height - MARGIN_Y:
                break

        if splash:
            tip = self.small.render("booting...", True, DIM)
            self.screen.blit(tip, (MARGIN_X, self.height - MARGIN_Y - CHAR_H))

        # Scanline-ish bars (subtle, still terminal-ish)
        for i in range(0, self.height, 4):
            pygame.draw.line(self.screen, (0, 0, 0), (0, i), (self.width, i), 1)

        pygame.display.flip()
